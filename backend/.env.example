# ==============================================================================
# Induwork ERP Backend — Variables de Entorno
# ==============================================================================
# Copia este archivo como .env y completa los valores reales.
# NUNCA hagas commit del archivo .env con valores reales.
# Este archivo .env.example SÍ puede estar en el repositorio.
# ==============================================================================

# ── Node ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
# development | production

# ── Puerto ─────────────────────────────────────────────────────────────────────
PORT=4000

# ── Base de Datos (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/induwork_erp?schema=public

# ── JWT ────────────────────────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# DEBEN ser distintos y de al menos 32 caracteres en producción.
JWT_SECRET=change_me_with_a_secure_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_me_with_a_different_secure_random_string_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Rate Limiting ───────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# ── CORS ────────────────────────────────────────────────────────────────────────
# En producción: lista separada por comas sin espacios, solo HTTPS.
# En desarrollo: dejar en blanco para usar la whitelist por defecto.
CORS_ORIGINS=

# ── Swagger ─────────────────────────────────────────────────────────────────────
# Solo habilitar en desarrollo. En producción la validación de config lo bloquea.
SWAGGER_ENABLED=true

# ── Registro Público de Usuarios ────────────────────────────────────────────────
PUBLIC_REGISTRATION_ENABLED=false
# Código del tenant donde se registran los nuevos usuarios públicos.
PUBLIC_REGISTRATION_TENANT_CODE=induwork

# ── Almacenamiento (Cloudflare R2 vía AWS S3 SDK) ───────────────────────────────
STORAGE_MOCK_MODE=true
# En producción configurar con credenciales reales de Cloudflare R2:
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
S3_BUCKET_NAME=induwork-erp
S3_PUBLIC_URL=https://pub.your-r2-domain.com

# ── Transbank Webpay Plus ────────────────────────────────────────────────────────
# Integración de pagos Chile. En desarrollo usa las credenciales de integración.
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
WEBPAY_ENVIRONMENT=integration
# integration | production
WEBPAY_RETURN_URL=https://yourdomain.cl/api/v1/payments/webpay/callback

# ── Flow (pasarela de pago alternativa) ─────────────────────────────────────────
FLOW_API_KEY=your_flow_api_key
FLOW_SECRET_KEY=your_flow_secret_key
FLOW_ENVIRONMENT=sandbox
# sandbox | production

# ── Mercado Pago Chile ───────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token

# ── Notificaciones ────────────────────────────────────────────────────────────────
# (Si usas SMTP para emails de notificación)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.cl
SMTP_PASS=your_smtp_password
SMTP_FROM="Induwork ERP <noreply@yourdomain.cl>"
