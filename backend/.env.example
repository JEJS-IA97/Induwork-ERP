# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/induwork_erp?schema=public"

# Security & CORS
# En producción debe declararse explícitamente y no debe incluir localhost.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://coimsa.erp.local,https://induwork.erp.local,https://inversionesmvi.erp.local"

# Rate Limiting (Throttler)
# Valores numéricos expresados en milisegundos / cantidad de solicitudes.
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# JWT Authentication
JWT_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="CHANGE_ME_WITH_A_DIFFERENT_LONG_RANDOM_SECRET"
JWT_REFRESH_EXPIRES_IN="7d"

# Public registration
# En producción debe ser false salvo que el negocio requiera registro público.
PUBLIC_REGISTRATION_ENABLED=false
PUBLIC_REGISTRATION_TENANT_CODE=

# Swagger
# Nunca debe activarse en producción.
SWAGGER_ENABLED=false

# Database seed
SEED_ADMIN_PASSWORD="CHANGE_ME_WITH_A_STRONG_RANDOM_PASSWORD"
SEED_SYSTEM_ADMIN_PASSWORD="CHANGE_ME_WITH_A_DIFFERENT_STRONG_RANDOM_PASSWORD"

# Correos de administradores iniciales del seed
SEED_SYSTEM_ADMIN_EMAIL="soporte@induwork.cl"
SEED_COIMSA_ADMIN_EMAIL="administracion@coimsaspa.cl"
SEED_INDUWORK_ADMIN_EMAIL="gerencia@induwork.cl"
SEED_INVERSIONES_MVI_ADMIN_EMAIL="administracion@inversionesmvi.cl"

# Seguridad adicional
ALLOW_PRODUCTION_SEED=false

# Default Tenants
DEFAULT_TENANTS="coimsa,induwork,inversiones-mvi"

# Storage / S3 / Cloudflare R2
# MOCK solo para desarrollo. En producción debe ser false.
STORAGE_MOCK_MODE=true
STORAGE_DRIVER="r2"
S3_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET_NAME="induwork-erp-storage"
S3_ACCESS_KEY_ID="your_r2_access_key_id"
S3_SECRET_ACCESS_KEY="your_r2_secret_access_key"
S3_PUBLIC_URL="https://storage.induwork.cl"

# Límites de Tamaño en Bytes
MAX_IMAGE_SIZE_BYTES=12582912
MAX_DOCUMENT_SIZE_BYTES=5242880

# Webpay
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
WEBPAY_RETURN_URL="http://localhost:5173/checkout/webpay/return"

# Payment Webhooks
# Mantener false hasta tener credenciales reales de cada integración.
PAYMENT_WEBHOOKS_ENABLED=false

# Flow
FLOW_API_KEY=
FLOW_SECRET_KEY=

# Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=
