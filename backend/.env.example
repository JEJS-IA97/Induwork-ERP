# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/induwork_erp?schema=public"

# Security & CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://Coimsa.erp.local,https://induwork.erp.local,https://inversionesmvi.erp.local"

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# JWT Authentication
JWT_SECRET="induwork_super_secret_jwt_access_key_2026_change_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="induwork_super_secret_jwt_refresh_key_2026_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# Default Tenants
DEFAULT_TENANTS="Coimsa,induwork,inversiones-mvi"

# ----------------------------------------------------
# Object Storage (Cloudflare R2 / AWS S3 / MinIO)
# ----------------------------------------------------
# STORAGE_DRIVER: 'r2' (Cloudflare R2), 's3' (AWS S3), o 'local' (desarrollo local sin credenciales)
STORAGE_DRIVER="r2"

# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# AWS S3: https://s3.<region>.amazonaws.com
S3_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET_NAME="induwork-erp-storage"
S3_ACCESS_KEY_ID="your_r2_access_key_id"
S3_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# URL pública para servir archivos (Cloudflare R2 Custom Domain o r2.dev)
# Ej: https://storage.induwork.cl o https://pub-xxxxxxxx.r2.dev
S3_PUBLIC_URL="https://storage.induwork.cl"

# Límites de Tamaño en Bytes
MAX_IMAGE_SIZE_BYTES=12582912 # 12 MB (12 * 1024 * 1024)
MAX_DOCUMENT_SIZE_BYTES=5242880 # 5 MB (5 * 1024 * 1024)
