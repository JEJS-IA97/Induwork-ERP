# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/induwork_erp?schema=public"

# Security & CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://coimsa.erp.local,https://induwork.erp.local,https://inversionesmvi.erp.local"

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# JWT Authentication
JWT_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="CHANGE_ME_WITH_A_DIFFERENT_LONG_RANDOM_SECRET"
JWT_REFRESH_EXPIRES_IN="7d"

# Public registration
PUBLIC_REGISTRATION_TENANT_CODE=YOUR_TENANT_CODE

# Swagger
# Desarrollo: puede omitirse y Swagger se habilita por defecto.
# Producción: Swagger queda deshabilitado salvo que se defina explícitamente true.
SWAGGER_ENABLED=false

# Database seed
# Obligatoria cuando se ejecuta el seed.
SEED_ADMIN_PASSWORD="CHANGE_ME_WITH_A_STRONG_RANDOM_PASSWORD"

# Seguridad adicional:
# Solo necesario si realmente se desea ejecutar el seed en producción.
ALLOW_PRODUCTION_SEED=false

# Default Tenants
DEFAULT_TENANTS="coimsa,induwork,inversiones-mvi"

STORAGE_DRIVER="r2"

S3_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET_NAME="induwork-erp-storage"
S3_ACCESS_KEY_ID="your_r2_access_key_id"
S3_SECRET_ACCESS_KEY="your_r2_secret_access_KEY"

# URL pública para servir archivos
# Ej: https://storage.induwork.cl o https://pub-xxxxxxxx.r2.dev
S3_PUBLIC_URL="https://storage.induwork.cl"

# Límites de Tamaño en Bytes
MAX_IMAGE_SIZE_BYTES=12582912
MAX_DOCUMENT_SIZE_BYTES=5242880

# Webpay
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
WEBPAY_RETURN_URL="http://localhost:5173/checkout/webpay/return"