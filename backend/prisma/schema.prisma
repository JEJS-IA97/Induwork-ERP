// ==============================================================================
// PRISMA SCHEMA - ERP CORPORATIVO MULTI-TENANT (PostgreSQL)
// Diseñado para reemplazar Odoo con arquitectura modular, variantes,
// fichas técnicas, catálogo web/impresión, control de stock, listas de precios,
// promociones, cupones, tarjetas de lealtad y auditoría inmutable.
// Empresas: Coimsa S.A., Induwork SpA, Inversiones MVI Ltda.
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum Role {
  ADMIN
  FINANCE
  INVENTORY_MANAGER
  VENDEDOR
  USER
}

enum CustomerType {
  CLIENTE
  PROVEEDOR
  AMBOS
}

enum StockMovementType {
  ENTRADA
  SALIDA
  AJUSTE
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELLED
  SHIPPED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

enum ProductDocumentType {
  FICHA_TECNICA
  MANUAL_USUARIO
  CERTIFICADO_CALIDAD
  HOJA_SEGURIDAD
  GARANTIA
  OTRO
}

// Enums para Listas de Precios y Promociones
enum PriceAdjustmentType {
  FIXED_PRICE             // Precio fijo específico
  PERCENTAGE_DISCOUNT     // Descuento porcentual sobre precio base (ej: -15%)
  PERCENTAGE_INCREASE     // Margen o aumento porcentual sobre costo/base (ej: +25%)
}

enum PromotionType {
  PROMO_CODE              // Código promocional (ej: "DESCUENTO10")
  AUTOMATIC_DISCOUNT      // Promoción automática en carrito / checkout
  FREE_SHIPPING           // Envío gratuito en órdenes superiores a $X
  BUY_X_GET_Y             // Comprar X unidades y recibir Y gratis (ej: 2x1, 3x2)
  NEXT_ORDER_COUPON       // Generar cupón válido para la siguiente compra
  LOYALTY_PROGRAM         // Tarjeta de lealtad por puntos o volumen (ej: compra 10, 10% en el 11°)
}

enum DiscountType {
  PERCENTAGE              // Descuento porcentual (%)
  FIXED_AMOUNT            // Monto fijo en CLP ($)
  FREE_SHIPPING           // Envío gratis
  FREE_PRODUCT            // Producto de regalo
}

enum CouponStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

// Enums para Compras (Purchases & Procurement)
enum PurchaseOrderStatus {
  RFQ
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

enum VendorBillStatus {
  DRAFT
  POSTED
  PAID
  CANCELLED
}

enum ThreeWayMatchStatus {
  MATCHED
  DISCREPANCY
  NOT_MATCHED
}

// Enums para Logística y DTE 52 (Guías de Despacho)
enum DispatchType {
  VENTA
  TRASLADO_INTERNO
  CONSIGNACION
  REPARACION_MANTENCION
  DEVOLUCION
}

enum DispatchGuideStatus {
  DRAFT
  ISSUED
  DELIVERED
  VOID
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

// Enums para Trazabilidad y Ensambles (Lotes, Series & Kits/BOM)
enum LotSerialType {
  SERIAL
  LOT
}

enum BomType {
  KIT
  MANUFACTURE
}

// ------------------------------------------------------------------------------
// 1. TENANT (Empresas / Dominios)
// ------------------------------------------------------------------------------

model Tenant {
  id          String   @id @default(uuid())
  code        String   @unique // 'coimsa', 'induwork', 'inversiones-mvi'
  name        String   // "Coimsa S.A.", "Induwork SpA", "Inversiones MVI Ltda."
  domain      String?  // "coimsa.erp.local", "induwork.erp.local", "inversionesmvi.erp.local"
  rutOrTaxId  String?  // RUT o Tax ID de la empresa
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String?  @default("Chile")
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones Multi-Tenant
  users               User[]
  customers           Customer[]
  categories          ProductCategory[]
  tags                ProductTag[]
  products            Product[]
  productVariants     ProductVariant[]
  productDocuments    ProductDocument[]
  productImages       ProductImage[]
  inventoryStocks     InventoryStock[]
  stockMovements      StockMovement[]
  priceLists          PriceList[]
  priceListItems      PriceListItem[]
  promotions          PromotionProgram[]
  coupons             Coupon[]
  loyaltyPrograms     LoyaltyProgram[]
  loyaltyCards        LoyaltyCard[]
  loyaltyTransactions LoyaltyTransaction[]
  orders              Order[]
  invoices            Invoice[]
  payments            Payment[]
  storageFiles        StorageFile[]
  notifications       Notification[]
  auditLogs           AuditLog[]

  // Compras, Logística DTE 52, Series/Lotes & BOM
  purchaseOrders      PurchaseOrder[]
  vendorProductPrices VendorProductPrice[]
  reorderingRules     ReorderingRule[]
  goodsReceipts       GoodsReceipt[]
  vendorBills         VendorBill[]
  dispatchGuides      DispatchGuide[]
  stockTransfers      StockTransfer[]
  productLotSerials   ProductLotSerial[]
  boms                BillOfMaterials[]

  @@map("tenants")
}

// ------------------------------------------------------------------------------
// 2. USER & ROLE (Usuarios y Permisos RBAC)
// ------------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role      @default(USER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relaciones
  refreshTokens          RefreshToken[]
  stockMovements         StockMovement[] @relation("StockMovementCreatedBy")
  purchaseOrdersCreated  PurchaseOrder[] @relation("POCreatedBy")
  goodsReceiptsValidated GoodsReceipt[]  @relation("ReceiptValidatedBy")
  stockTransfersCreated  StockTransfer[] @relation("TransferCreatedBy")
  notifications          Notification[]
  auditLogs              AuditLog[]

  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ------------------------------------------------------------------------------
// 3. CUSTOMER & SUPPLIER (Clientes y Proveedores)
// ------------------------------------------------------------------------------

model Customer {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type         CustomerType @default(CLIENTE)
  rutOrTaxId   String?
  name         String       // Razón Social o Nombre Completo
  email        String?
  phone        String?
  address      String?
  city         String?
  country      String?      @default("Chile")
  isActive     Boolean      @default(true)
  notes        String?
  
  // Lista de precios por defecto para el cliente
  priceListId  String?
  priceList    PriceList?   @relation(fields: [priceListId], references: [id], onDelete: SetNull)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relaciones
  orders              Order[]
  invoices            Invoice[]
  coupons             Coupon[]
  loyaltyCards        LoyaltyCard[]
  purchaseOrders      PurchaseOrder[]
  vendorProductPrices VendorProductPrice[]
  reorderingRules     ReorderingRule[]
  goodsReceipts       GoodsReceipt[]
  vendorBills         VendorBill[]
  dispatchGuides      DispatchGuide[]

  @@index([tenantId])
  @@index([tenantId, rutOrTaxId])
  @@map("customers")
}

// ------------------------------------------------------------------------------
// 4. CATEGORÍAS Y ETIQUETAS DE PRODUCTOS
// ------------------------------------------------------------------------------

model ProductCategory {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  parentId    String?
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductCategory[] @relation("CategoryHierarchy")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("product_categories")
}

model ProductTag {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  color     String?  @default("#3B82F6")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductTagAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("product_tags")
}

model ProductTagAssignment {
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String
  tag       ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tag_assignments")
}

// ------------------------------------------------------------------------------
// 5. PRODUCT & STOCK (Catálogo, Variantes, Imágenes, Fichas e Inventario)
// ------------------------------------------------------------------------------

model Product {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Identificadores y Nomenclaturas
  sku              String   // Código SKU principal
  barcode          String?  // Código de barras / EAN13
  
  // Nombres diferenciados para Web y Orden/Factura (evita facturas sobreextendidas)
  name             String   // Nombre estándar / interno
  webName          String?  // Nombre optimizado para el sitio web
  orderName        String?  // Nombre conciso para órdenes de venta e impresión de factura
  
  // Descripciones diferenciadas
  description      String?  // Descripción interna
  webDescription   String?  @db.Text // Descripción enriquecida y extensa para eCommerce/Web
  orderDescription String?  // Descripción compacta para el PDF de la orden/factura
  
  // Precios, Costos e Impuestos
  price            Decimal  @default(0.0) @db.Decimal(14, 2)
  cost             Decimal  @default(0.0) @db.Decimal(14, 2)
  taxRate          Decimal  @default(19.0) @db.Decimal(5, 2) // Porcentaje de IVA (ej: 19%)
  taxIncluded      Boolean  @default(false)
  
  // Imágenes
  mainImageUrl     String?
  imageUrls        String[] @default([]) // Array de URLs directas para compatibilidad rápida
  
  // Estados de Ciclo de Vida y Publicación
  isActive         Boolean  @default(true)
  isArchived       Boolean  @default(false) // Archivar producto sin eliminar historial
  isPublishedWeb   Boolean  @default(false) // Publicado en catálogo web / tienda online
  hasVariants      Boolean  @default(false) // Indica si utiliza variantes hijas
  
  // Métricas y Contadores
  salesCount       Int      @default(0) // Contador de unidades vendidas históricamente
  
  // Categoría
  categoryId       String?
  category         ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Duplicación/Clonación (opcional referencia de origen)
  clonedFromId     String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relaciones
  tags               ProductTagAssignment[]
  galleryImages      ProductImage[]
  documents          ProductDocument[]
  variants           ProductVariant[]
  inventoryStocks    InventoryStock[]
  stockMovements     StockMovement[]
  priceListItems     PriceListItem[]
  orderItems         OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  vendorPrices       VendorProductPrice[]
  reorderingRules    ReorderingRule[]
  goodsReceiptItems  GoodsReceiptItem[]
  dispatchGuideItems DispatchGuideItem[]
  stockTransferItems StockTransferItem[]
  lotSerials         ProductLotSerial[]
  bomsAsParent       BillOfMaterials[]    @relation("ParentProductBom")
  bomComponents      BomComponent[]       @relation("ComponentProduct")

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, barcode])
  @@index([tenantId, isPublishedWeb, isArchived])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  altText    String?
  isMain     Boolean  @default(false) // Imagen principal
  orderIndex Int      @default(0)     // Orden para el carrusel de imágenes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([productId])
  @@map("product_images")
}

model ProductDocument {
  id           String              @id @default(uuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  title        String              // Ej: "Ficha Técnica Bomba 5HP", "Manual de Operación"
  fileUrl      String
  fileType     String              // Ej: "application/pdf"
  fileSize     Int                 // Tamaño en bytes
  documentType ProductDocumentType @default(FICHA_TECNICA)
  isPublic     Boolean             @default(true) // Visible para descarga de clientes
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([tenantId])
  @@index([productId])
  @@map("product_documents")
}

model ProductVariant {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sku         String   // SKU específico de la variante (ej: "BOMBA-5HP-ROJO-XL")
  barcode     String?
  name        String   // Ej: "Talla L / Color Azul"
  
  // Precios específicos de variante (o hereda del padre si es null)
  price       Decimal? @db.Decimal(14, 2)
  cost        Decimal? @db.Decimal(14, 2)
  
  // Atributos en formato Json (ej: {"color": "Azul", "talla": "L", "voltaje": "380V"})
  attributes  Json     @default("{}")
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  inventoryStocks    InventoryStock[]
  stockMovements     StockMovement[]
  priceListItems     PriceListItem[]
  orderItems         OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  vendorPrices       VendorProductPrice[]
  reorderingRules    ReorderingRule[]
  goodsReceiptItems  GoodsReceiptItem[]
  dispatchGuideItems DispatchGuideItem[]
  stockTransferItems StockTransferItem[]
  lotSerials         ProductLotSerial[]
  bomsAsParent       BillOfMaterials[]    @relation("ParentVariantBom")
  bomComponents      BomComponent[]       @relation("ComponentVariant")

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([productId])
  @@map("product_variants")
}

model InventoryStock {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  
  warehouseLocation String          @default("BODEGA_CENTRAL") // Bodega o ubicación física
  currentStock      Int             @default(0) // Existencia física disponible
  reservedStock     Int             @default(0) // Stock comprometido en órdenes pendientes
  minStock          Int             @default(5) // Alerta de stock mínimo
  maxStock          Int             @default(1000)
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([tenantId, productId, warehouseLocation, variantId])
  @@index([tenantId])
  @@index([productId])
  @@index([warehouseLocation])
  @@map("inventory_stocks")
}

model StockMovement {
  id                String            @id @default(uuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId         String
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  
  type              StockMovementType
  quantity          Int               // Cantidad movida
  unitCost          Decimal?          @db.Decimal(14, 2)
  warehouseLocation String            @default("BODEGA_CENTRAL")
  reference         String            // Ej: "Ajuste manual", "Factura #123", "Orden ORD-0042", "Recepción Proveedor"
  
  createdById       String?
  createdBy         User?             @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([tenantId])
  @@index([productId])
  @@index([type])
  @@map("stock_movements")
}

// ------------------------------------------------------------------------------
// 6. LISTAS DE PRECIOS Y GESTIÓN MASIVA
// ------------------------------------------------------------------------------

model PriceList {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String    // Ej: "Mayorista Minería", "Distribuidor Región Norte", "Minorista Web"
  code        String    // Ej: "PL-MAYORISTA"
  description String?
  isDefault   Boolean   @default(false)
  currency    String    @default("CLP")
  
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relaciones
  items       PriceListItem[]
  customers   Customer[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("price_lists")
}

model PriceListItem {
  id                String              @id @default(uuid())
  tenantId          String
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceListId       String
  priceList         PriceList           @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  
  productId         String
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?
  variant           ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  
  adjustmentType    PriceAdjustmentType @default(FIXED_PRICE)
  fixedPrice        Decimal?            @db.Decimal(14, 2)
  percentAdjustment Decimal?            @db.Decimal(6, 2) // Ej: -15.00% o +25.00%
  minQuantity       Int                 @default(1) // Cantidad mínima para aplicar precio
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([tenantId, priceListId, productId, variantId, minQuantity])
  @@index([tenantId])
  @@index([priceListId])
  @@index([productId])
  @@map("price_list_items")
}

// ------------------------------------------------------------------------------
// 7. PROGRAMAS PROMOCIONALES, CUPONES Y LEALTAD
// ------------------------------------------------------------------------------

model PromotionProgram {
  id                 String        @id @default(uuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String        // Ej: "Envío Gratis > $50.000", "Promo 10% Verano", "Lleva 2 y el 3ro Gratis"
  code               String?       // Código de cupón si aplica (ej: "PROMO10", "INVERSIÓN2026")
  type               PromotionType
  discountType       DiscountType  @default(PERCENTAGE)
  discountValue      Decimal       @default(0.0) @db.Decimal(14, 2) // 10% o $10.000
  
  // Condiciones
  minOrderAmount     Decimal?      @db.Decimal(14, 2) // Monto mínimo de orden (ej: $50.000 para envío gratis)
  buyQuantity        Int?          // Para Buy X Get Y (ej: Compra 2...)
  getQuantity        Int?          // (... y obtén 1 gratis)
  rewardProductId    String?       // Producto de regalo o bonificado
  
  // Regla de lealtad por volumen (ej: compra 10, obtén 10% en el 11°)
  loyaltyTargetCount Int?          @default(10)
  
  maxUsageCount      Int?          // Límite global de usos
  currentUsageCount  Int           @default(0)
  
  startDate          DateTime?
  endDate            DateTime?
  isActive           Boolean       @default(true)
  
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  coupons            Coupon[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, type, isActive])
  @@map("promotion_programs")
}

model Coupon {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId      String
  program        PromotionProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  
  code           String           // Código único generado (ej: "NEXT-COIMSA-88321")
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  status         CouponStatus     @default(ACTIVE)
  discountValue  Decimal?         @db.Decimal(14, 2)
  expirationDate DateTime?
  
  usedAt         DateTime?
  usedInOrderId  String?
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@map("coupons")
}

model LoyaltyProgram {
  id                String        @id @default(uuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String        @default("Programa de Puntos y Lealtad")
  pointsPerSpent    Decimal       @default(1.0) @db.Decimal(10, 4) // Puntos ganados por cada $1.000 CLP
  minPointsToRedeem Int           @default(100)
  pointsValueClp    Decimal       @default(10.0) @db.Decimal(10, 2) // Cada punto equivale a $10 CLP
  isActive          Boolean       @default(true)
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  cards             LoyaltyCard[]

  @@index([tenantId])
  @@map("loyalty_programs")
}

model LoyaltyCard {
  id                  String               @id @default(uuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId           String
  program             LoyaltyProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  cardNumber          String               // Ej: "CARD-COIMSA-1002"
  currentPoints       Int                  @default(0)
  totalEarnedPoints   Int                  @default(0)
  totalSpentPoints    Int                  @default(0)
  totalPurchasesCount Int                  @default(0) // Contador de compras para recompensas por repetición
  
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  transactions        LoyaltyTransaction[]

  @@unique([tenantId, customerId])
  @@unique([tenantId, cardNumber])
  @@index([tenantId])
  @@map("loyalty_cards")
}

model LoyaltyTransaction {
  id          String      @id @default(uuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cardId      String
  card        LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  orderId     String?
  
  points      Int         // Positivo para ganar, negativo para canjear
  type        String      // "EARNED", "REDEEMED", "BONUS", "PURCHASE_MILESTONE"
  description String      // Ej: "Puntos por Orden ORD-1002", "Canje de descuento $5.000"
  
  createdAt   DateTime    @default(now())

  @@index([tenantId])
  @@index([cardId])
  @@map("loyalty_transactions")
}

// ------------------------------------------------------------------------------
// 8. ORDER & INVOICE (Ventas y Facturación Electrónica)
// ------------------------------------------------------------------------------

model Order {
  id              String      @id @default(uuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber     String      // Ej: "ORD-2026-0001"
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status          OrderStatus @default(DRAFT)
  
  // Desglose Financiero
  subtotalAmount  Decimal     @default(0.0) @db.Decimal(14, 2)
  discountAmount  Decimal     @default(0.0) @db.Decimal(14, 2)
  taxAmount       Decimal     @default(0.0) @db.Decimal(14, 2)
  totalAmount     Decimal     @default(0.0) @db.Decimal(14, 2)
  
  // Promociones y Cupones Aplicados
  appliedCouponCode String?
  appliedPromotionName String?
  
  notes           String?
  shippingAddress String?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
  invoices        Invoice[]
  dispatchGuides  DispatchGuide[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                 String          @id @default(uuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  
  productName        String          // Nombre congelado al momento de venta
  productDescription String?         // Descripción para factura
  
  quantity           Int             @default(1)
  unitPrice          Decimal         @db.Decimal(14, 2)
  unitCost           Decimal?        @db.Decimal(14, 2)
  taxRate            Decimal         @default(19.0) @db.Decimal(5, 2)
  discountPercent    Decimal         @default(0.0) @db.Decimal(5, 2)
  subtotal           Decimal         @db.Decimal(14, 2)
  total              Decimal         @db.Decimal(14, 2)
  
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@map("order_items")
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  invoiceNumber  String        // Ej: "FAC-2026-0001"
  status         InvoiceStatus @default(DRAFT)
  paymentStatus  PaymentStatus @default(PENDING)
  paymentMethod  String?       // "Webpay", "Transferencia", "Efectivo", "Crédito 30 días"
  
  pdfUrl         String?
  xmlUrl         String?
  issuedAt       DateTime?
  dueDate        DateTime?
  
  subtotalAmount Decimal       @default(0.0) @db.Decimal(14, 2)
  taxAmount      Decimal       @default(0.0) @db.Decimal(14, 2)
  totalAmount    Decimal       @default(0.0) @db.Decimal(14, 2)
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments       Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@map("invoices")
}

model Payment {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(14, 2)
  status         PaymentStatus @default(COMPLETED)
  paymentMethod  String        @default("TRANSFER")
  transactionRef String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payments")
}

model StorageFile {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@map("storage_files")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@map("notifications")
}

// ------------------------------------------------------------------------------
// 9. AUDIT LOG (Registro de Auditoría Inmutable para Seguridad)
// ------------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action     String   // Ej: "CREATE_PRODUCT", "BULK_PRICE_UPDATE", "APPLY_PROMO", "CREATE_INVOICE"
  entityName String   // "Product", "Order", "PriceList", "PromotionProgram", "Coupon", "Invoice"
  entityId   String   // ID del registro auditado
  
  ipAddress  String?
  userAgent  String?
  oldValues  Json?
  newValues  Json?
  
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, entityName, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// 10. COMPRAS Y ABASTECIMIENTO (Purchases, 3-Way Matching, Vendor Bills)
// ------------------------------------------------------------------------------

model PurchaseOrder {
  id             String              @id @default(uuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  poNumber       String              // Ej: "OC-2026-0001"
  supplierId     String
  supplier       Customer            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status         PurchaseOrderStatus @default(RFQ)
  
  orderDate      DateTime            @default(now())
  expectedDate   DateTime?
  subtotalAmount Decimal             @default(0.0) @db.Decimal(14, 2)
  taxAmount      Decimal             @default(0.0) @db.Decimal(14, 2)
  totalAmount    Decimal             @default(0.0) @db.Decimal(14, 2)
  notes          String?
  
  createdById    String?
  createdBy      User?               @relation("POCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  items          PurchaseOrderItem[]
  goodsReceipts  GoodsReceipt[]
  vendorBills    VendorBill[]
  lotsSerials    ProductLotSerial[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String          @id @default(uuid())
  poId             String
  po               PurchaseOrder   @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  
  productName      String
  quantity         Int             @default(1)
  receivedQuantity Int             @default(0)
  unitCost         Decimal         @db.Decimal(14, 2)
  taxRate          Decimal         @default(19.0) @db.Decimal(5, 2)
  subtotal         Decimal         @db.Decimal(14, 2)
  total            Decimal         @db.Decimal(14, 2)
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("purchase_order_items")
}

model VendorProductPrice {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId       String
  supplier         Customer        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  
  supplierSku      String?
  unitCost         Decimal         @db.Decimal(14, 2)
  minQuantity      Int             @default(1)
  deliveryLeadDays Int             @default(3)
  currency         String          @default("CLP")
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([tenantId, supplierId, productId, variantId, minQuantity])
  @@index([tenantId])
  @@index([supplierId])
  @@index([productId])
  @@map("vendor_product_prices")
}

model ReorderingRule {
  id                  String          @id @default(uuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId           String
  product             Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId           String?
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  
  warehouseLocation   String          @default("BODEGA_CENTRAL")
  minStock            Int             @default(5)
  maxStock            Int             @default(50)
  qtyToOrder          Int             @default(20)
  
  preferredSupplierId String?
  preferredSupplier   Customer?       @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  isActive            Boolean         @default(true)
  
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([tenantId, productId, variantId, warehouseLocation])
  @@index([tenantId])
  @@index([productId])
  @@map("reordering_rules")
}

model GoodsReceipt {
  id                String             @id @default(uuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receiptNumber     String             // Ej: "REC-2026-0001"
  poId              String?
  po                PurchaseOrder?     @relation(fields: [poId], references: [id], onDelete: SetNull)
  supplierId        String
  supplier          Customer           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseLocation String             @default("BODEGA_CENTRAL")
  status            GoodsReceiptStatus @default(DRAFT)
  receivedAt        DateTime           @default(now())
  notes             String?
  
  validatedById     String?
  validatedBy       User?              @relation("ReceiptValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  items             GoodsReceiptItem[]
  vendorBills       VendorBill[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([poId])
  @@index([supplierId])
  @@index([status])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id               String            @id @default(uuid())
  receiptId        String
  receipt          GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId        String?
  variant          ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  lotSerialId      String?
  lotSerial        ProductLotSerial? @relation(fields: [lotSerialId], references: [id], onDelete: SetNull)
  
  quantityReceived Int               @default(1)
  unitCost         Decimal           @db.Decimal(14, 2)
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("goods_receipt_items")
}

model VendorBill {
  id                    String              @id @default(uuid())
  tenantId              String
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billNumber            String              // Factura Proveedor Ej: "FAC-PROV-99812"
  supplierId            String
  supplier              Customer            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  poId                  String?
  po                    PurchaseOrder?      @relation(fields: [poId], references: [id], onDelete: SetNull)
  receiptId             String?
  receipt               GoodsReceipt?       @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  
  dteType               Int                 @default(33) // Factura 33
  status                VendorBillStatus    @default(DRAFT)
  matchStatus           ThreeWayMatchStatus @default(NOT_MATCHED)
  matchDiscrepancyNotes String?             // Discrepancia 3-Way Matching
  
  issueDate             DateTime            @default(now())
  dueDate               DateTime?
  subtotalAmount        Decimal             @default(0.0) @db.Decimal(14, 2)
  taxAmount             Decimal             @default(0.0) @db.Decimal(14, 2)
  totalAmount           Decimal             @default(0.0) @db.Decimal(14, 2)
  
  xmlUrl                String?
  pdfUrl                String?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([tenantId, supplierId, billNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
  @@index([matchStatus])
  @@map("vendor_bills")
}

// ------------------------------------------------------------------------------
// 11. LOGÍSTICA Y GUÍAS DE DESPACHO DTE 52 (Guías SII & Traslados)
// ------------------------------------------------------------------------------

model DispatchGuide {
  id                   String              @id @default(uuid())
  tenantId             String
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guideNumber          String              // Ej: "GD-2026-0001"
  dteType              Int                 @default(52) // DTE Tipo 52 Guía de Despacho
  
  orderId              String?
  order                Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  transferId           String?             @unique
  transfer             StockTransfer?      @relation(fields: [transferId], references: [id], onDelete: SetNull)
  customerId           String?
  customer             Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  dispatchType         DispatchType        @default(VENTA)
  status               DispatchGuideStatus @default(DRAFT)
  
  originWarehouse      String              @default("BODEGA_CENTRAL")
  destinationWarehouse String?
  destinationAddress   String?
  
  carrierRut           String?
  carrierName          String?
  vehiclePlate         String?
  driverName           String?
  driverRut            String?
  
  xmlUrl               String?
  pdfUrl               String?
  tedBarcode           String?             @db.Text // Timbre Electrónico DTE 52
  issuedAt             DateTime?
  deliveredAt          DateTime?
  
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  items                DispatchGuideItem[]

  @@unique([tenantId, guideNumber])
  @@index([tenantId])
  @@index([dispatchType])
  @@index([status])
  @@map("dispatch_guides")
}

model DispatchGuideItem {
  id          String            @id @default(uuid())
  guideId     String
  guide       DispatchGuide     @relation(fields: [guideId], references: [id], onDelete: Cascade)
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId   String?
  variant     ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  lotSerialId String?
  lotSerial   ProductLotSerial? @relation(fields: [lotSerialId], references: [id], onDelete: SetNull)
  
  quantity    Int               @default(1)
  unitPrice   Decimal           @db.Decimal(14, 2)
  subtotal    Decimal           @db.Decimal(14, 2)
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("dispatch_guide_items")
}

model StockTransfer {
  id                   String              @id @default(uuid())
  tenantId             String
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transferNumber       String              // Ej: "TRF-2026-0001"
  sourceWarehouse      String              // Ej: "BODEGA_CENTRAL"
  destinationWarehouse String              // Ej: "BODEGA_ANTOFAGASTA"
  status               TransferStatus      @default(DRAFT)
  
  dispatchedAt         DateTime?
  receivedAt           DateTime?
  createdById          String?
  createdBy            User?               @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  items                StockTransferItem[]
  dispatchGuide        DispatchGuide?

  @@unique([tenantId, transferNumber])
  @@index([tenantId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                String            @id @default(uuid())
  transferId        String
  transfer          StockTransfer     @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId         String
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId         String?
  variant           ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  lotSerialId       String?
  lotSerial         ProductLotSerial? @relation(fields: [lotSerialId], references: [id], onDelete: SetNull)
  
  quantityRequested Int               @default(1)
  quantitySent      Int               @default(0)
  quantityReceived  Int               @default(0)
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("stock_transfer_items")
}

// ------------------------------------------------------------------------------
// 12. TRAZABILIDAD Y ENSAMBLES (Series, Lotes & Kits/BOM)
// ------------------------------------------------------------------------------

model ProductLotSerial {
  id                 String              @id @default(uuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId          String?
  variant            ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  
  lotOrSerialNumber  String              // Ej: "SN-2026-BOMBA-9942", "LOTE-2026-03"
  type               LotSerialType       @default(SERIAL)
  initialQuantity    Int                 @default(1)
  currentQuantity    Int                 @default(1)
  warehouseLocation  String              @default("BODEGA_CENTRAL")
  
  expirationDate     DateTime?
  warrantyEndDate    DateTime?
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  goodsReceiptItems  GoodsReceiptItem[]
  dispatchGuideItems DispatchGuideItem[]
  stockTransferItems StockTransferItem[]

  @@unique([tenantId, productId, variantId, lotOrSerialNumber])
  @@index([tenantId])
  @@index([productId])
  @@index([lotOrSerialNumber])
  @@map("product_lot_serials")
}

model BillOfMaterials {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentProductId String
  parentProduct   Product        @relation("ParentProductBom", fields: [parentProductId], references: [id], onDelete: Cascade)
  parentVariantId String?
  parentVariant   ProductVariant? @relation("ParentVariantBom", fields: [parentVariantId], references: [id], onDelete: SetNull)
  
  code            String         // Ej: "BOM-KIT-BOMBA-5HP"
  name            String         // Ej: "Kit de Bombeo Industrial 5HP Trifásico"
  type            BomType        @default(KIT)
  isActive        Boolean        @default(true)
  notes           String?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  components      BomComponent[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentProductId])
  @@map("bill_of_materials")
}

model BomComponent {
  id                 String          @id @default(uuid())
  bomId              String
  bom                BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentProductId String
  componentProduct   Product         @relation("ComponentProduct", fields: [componentProductId], references: [id], onDelete: Restrict)
  componentVariantId String?
  componentVariant   ProductVariant? @relation("ComponentVariant", fields: [componentVariantId], references: [id], onDelete: SetNull)
  
  quantity           Int             @default(1)
  
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([bomId])
  @@index([componentProductId])
  @@map("bom_components")
}
